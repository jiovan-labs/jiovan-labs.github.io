{
    "name": "jiovan-labs.github.io",
    "version": "2.0.0",
    "title": "Jiovan Official Site",
    "description": "Awesome Open-Source Software Provider",
    "homepage": "https://jiovan-labs.github.io",
    "organization": "Jiovan Ltd",
    "private": true,
    "license": "MIT",
    "keywords": [
        "jiovan",
        "jiovan-official-site"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "approve": "npm approve-scripts --allow-scripts-pending",
        "start": "NODE_OPTIONS=--openssl-legacy-provider dumi dev",
        "build:watch": "father dev",
        "docs:build": "del-cli ./docs-dist && NODE_OPTIONS=--openssl-legacy-provider dumi build",
        "docs:publish": "gh-pages -d ./docs-dist",
        "upgrade": "npx npm-check-updates --target semver -u"
    },
    "devDependencies": {
        "del-cli": "^7.0.0",
        "dumi": "^1.1.54",
        "typescript": "^4.9.5",
        "gh-pages": "^6.3.0"
    },
    "peerDependencies": {
        "typescript": ">=4.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jiovan-labs/jiovan-labs.github.io.git"
    },
    "bugs": {
        "url": "https://github.com/jiovan-labs/jiovan-labs.github.io/issues"
    },
    "collective": {
        "url": "https://opencollective.com/joivan-labs"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/joivan-labs"
        },
        {
            "type": "individual",
            "url": "https://joivan.com/donation"
        }
    ],
    "browserslist": {
        "production": [
            "> 0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "author": {
        "name": "Jiovan Ltd",
        "url": "https://joivan.com"
    },
    "contributors": [
        {
            "name": "David Hsing",
            "email": "davidhsing@163.com",
            "url": "https://github.com/davidhsing"
        }
    ],
    "allowScripts": {
        "core-js": true,
        "core-js-pure": true,
        "esbuild": true,
        "fsevents": true
    }
}
